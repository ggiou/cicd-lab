pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    sh './gradlew clean assemble'
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    sh './gradlew test'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t cicd-lab-app -f docker/Dockerfile .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f cicd-lab-app || true

                    docker run -d \
                        --name cicd-lab-app \
                        -p 8081:8080 \
                        cicd-lab-app
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    for i in {1..10}; do
                        if curl -fs http://host.docker.internal:8081/api/health; then
                            echo "Health check passed"
                            exit 0
                        fi

                        echo "Waiting for application..."
                        sleep 3
                    done

                    echo "Health check failed"
                    exit 1
                '''
            }
        }
    }
}